[Unit]
Description=Restart the Kraken LCD stream after resume (USB re-enumerates on wake)
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
# Give USB a moment to re-enumerate before reopening the device.
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/systemctl try-restart kraken-lcd.service

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
